-- THIS UI IS ORIGINALLY MADE BY ESORE
-- EXTENSIVELY ENHANCED, OPTIMIZED & RESIZABLE VERSION

local SimpleLib = {}

-->> SERVICES
local CoreGui = game:GetService("CoreGui")
local UIS = game:GetService("UserInputService")
local TweenService = game:GetService("TweenService")

-- RED THEME COLOR PALETTE
local RED_ACCENT = Color3.fromRGB(220, 53, 69)
local RED_DARK = Color3.fromRGB(139, 0, 0)
local RED_LIGHT = Color3.fromRGB(255, 99, 99)
local BG_DARK = Color3.fromRGB(25, 25, 35)
local BG_MEDIUM = Color3.fromRGB(40, 40, 55)
local TEXT_COLOR = Color3.fromRGB(255, 255, 255)

-- HELPER TWEEN FUNCTION
local function fastTween(object, info, properties)
    local t = TweenService:Create(object, info, properties)
    t:Play()
    return t
end

function SimpleLib:Window(winName)
    local sliderInUse = false
    local isResizing = false
    local resizeStart = nil
    local resizeStartSize = nil
    local activeConnections = {}

    local function trackConnection(conn)
        table.insert(activeConnections, conn)
        return conn
    end

    local function cleanupConnections()
        for _, conn in ipairs(activeConnections) do
            if conn then conn:Disconnect() end
        end
        table.clear(activeConnections)
    end

    -- Smooth Drag Engine
    local function dragify(Frame)
        local dragToggle, dragInput, dragStart, startPos
        
        trackConnection(Frame.InputBegan:Connect(function(input)
            if sliderInUse or isResizing then return end
            if (input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch) 
            and UIS:GetFocusedTextBox() == nil then
                dragToggle = true
                dragStart = input.Position
                startPos = Frame.Position
                
                trackConnection(input.Changed:Connect(function()
                    if input.UserInputState == Enum.UserInputState.End then
                        dragToggle = false
                    end
                end))
            end
        end))

        trackConnection(Frame.InputChanged:Connect(function(input)
            if input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch then
                dragInput = input
            end
        end))

        trackConnection(UIS.InputChanged:Connect(function(input)
            if input == dragInput and dragToggle then
                local Delta = input.Position - dragStart
                local Position = UDim2.new(
                    startPos.X.Scale, startPos.X.Offset + Delta.X,
                    startPos.Y.Scale, startPos.Y.Offset + Delta.Y
                )
                fastTween(Frame, TweenInfo.new(0.12, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {Position = Position})
            end
        end))
    end

    -- Smooth Resize Engine
    local function setupResize(Frame)
        local ResizeHandle = Instance.new("Frame")
        ResizeHandle.Name = "ResizeHandle"
        ResizeHandle.Size = UDim2.new(0, 18, 0, 18)
        ResizeHandle.Position = UDim2.new(1, -6, 1, -6)
        ResizeHandle.AnchorPoint = Vector2.new(1, 1)
        ResizeHandle.BackgroundColor3 = RED_ACCENT
        ResizeHandle.BorderSizePixel = 0
        ResizeHandle.ZIndex = 100
        ResizeHandle.Parent = Frame

        local Corner = Instance.new("UICorner")
        Corner.CornerRadius = UDim.new(0, 4)
        Corner.Parent = ResizeHandle

        local Icon = Instance.new("TextLabel")
        Icon.Size = UDim2.new(1, 0, 1, 0)
        Icon.BackgroundTransparency = 1
        Icon.Text = "⤡"
        Icon.TextColor3 = TEXT_COLOR
        Icon.TextSize = 12
        Icon.Font = Enum.Font.GothamBold
        Icon.Parent = ResizeHandle

        trackConnection(ResizeHandle.InputBegan:Connect(function(input)
            if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
                isResizing = true
                resizeStart = input.Position
                resizeStartSize = Frame.Size
            end
        end))

        trackConnection(UIS.InputChanged:Connect(function(input)
            if isResizing and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
                local Delta = input.Position - resizeStart
                local newWidth = math.max(350, resizeStartSize.X.Offset + Delta.X)
                local newHeight = math.max(280, resizeStartSize.Y.Offset + Delta.Y)
                Frame.Size = UDim2.new(0, newWidth, 0, newHeight)
            end
        end))

        trackConnection(UIS.InputEnded:Connect(function(input)
            if isResizing and (input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch) then
                isResizing = false
            end
        end))

        trackConnection(ResizeHandle.MouseEnter:Connect(function()
            fastTween(ResizeHandle, TweenInfo.new(0.2), {BackgroundColor3 = RED_LIGHT})
        end))

        trackConnection(ResizeHandle.MouseLeave:Connect(function()
            fastTween(ResizeHandle, TweenInfo.new(0.2), {BackgroundColor3 = RED_ACCENT})
        end))
    end

    -- Windows Instantiation
    local MainGUI = Instance.new("ScreenGui")
    MainGUI.IgnoreGuiInset = true
    MainGUI.Parent = CoreGui

    local MainBG = Instance.new("Frame")
    MainBG.Name = "MainBG"
    MainBG.Position = UDim2.new(0.3, 0, 0.3, 0)
    MainBG.Size = UDim2.new(0, 520, 0, 400)
    MainBG.BorderSizePixel = 0
    MainBG.BackgroundColor3 = BG_DARK
    MainBG.Parent = MainGUI

    local UIGradient = Instance.new("UIGradient")
    UIGradient.Rotation = -90
    UIGradient.Color = ColorSequence.new{
        ColorSequenceKeypoint.new(0, BG_MEDIUM),
        ColorSequenceKeypoint.new(1, BG_DARK)
    }
    UIGradient.Parent = MainBG

    local UICorner = Instance.new("UICorner")
    UICorner.CornerRadius = UDim.new(0, 12)
    UICorner.Parent = MainBG

    local UIStroke = Instance.new("UIStroke")
    UIStroke.Color = RED_ACCENT
    UIStroke.Thickness = 1.5
    UIStroke.Parent = MainBG

    local SectionContainer = Instance.new("Frame")
    SectionContainer.Name = "SectionContainer"
    SectionContainer.BackgroundColor3 = BG_MEDIUM
    SectionContainer.BackgroundTransparency = 0.2
    SectionContainer.BorderSizePixel = 0
    -- Fluid scaling mapping adjustments
    SectionContainer.Position = UDim2.new(0, 12, 0, 45)
    SectionContainer.Size = UDim2.new(1, -24, 1, -57)
    SectionContainer.Parent = MainBG

    local UICorner2 = Instance.new("UICorner")
    UICorner2.CornerRadius = UDim.new(0, 10)
    UICorner2.Parent = SectionContainer

    local TabsContainer = Instance.new("Frame")
    TabsContainer.Name = "TabsContainer"
    TabsContainer.BackgroundTransparency = 1
    TabsContainer.Position = UDim2.new(0, 0, 0, 0)
    TabsContainer.Size = UDim2.new(1, 0, 0, 36)
    TabsContainer.Parent = SectionContainer

    local UIListLayout = Instance.new("UIListLayout")
    UIListLayout.FillDirection = Enum.FillDirection.Horizontal
    UIListLayout.SortOrder = Enum.SortOrder.LayoutOrder
    UIListLayout.Padding = UDim.new(0, 6)
    UIListLayout.Parent = TabsContainer

    local Padding = Instance.new("UIPadding")
    Padding.PaddingLeft = UDim.new(0, 8)
    Padding.PaddingTop = UDim.new(0, 6)
    Padding.Parent = TabsContainer

    local Divider = Instance.new("Frame")
    Divider.Name = "Divider"
    Divider.Position = UDim2.new(0, 8, 0, 36)
    Divider.Size = UDim2.new(1, -16, 0, 2)
    Divider.BorderSizePixel = 0
    Divider.BackgroundColor3 = RED_ACCENT
    Divider.Parent = SectionContainer

    local Header = Instance.new("TextLabel")
    Header.Name = "Header"
    Header.Text = winName
    Header.Font = Enum.Font.GothamBold
    Header.TextSize = 16
    Header.TextColor3 = TEXT_COLOR
    Header.TextXAlignment = Enum.TextXAlignment.Left
    Header.BackgroundTransparency = 1
    Header.Position = UDim2.new(0, 16, 0, 10)
    Header.Size = UDim2.new(0.6, 0, 0, 24)
    Header.Parent = MainBG

    local CloseBtn = Instance.new("TextButton")
    CloseBtn.Name = "CloseBtn"
    CloseBtn.Text = "✕"
    CloseBtn.Font = Enum.Font.GothamBold
    CloseBtn.TextSize = 14
    CloseBtn.TextColor3 = TEXT_COLOR
    CloseBtn.BackgroundColor3 = RED_ACCENT
    CloseBtn.Position = UDim2.new(1, -36, 0, 10)
    CloseBtn.Size = UDim2.new(0, 26, 0, 26)
    CloseBtn.Parent = MainBG

    local CloseBtnCorner = Instance.new("UICorner")
    CloseBtnCorner.CornerRadius = UDim.new(0, 6)
    CloseBtnCorner.Parent = CloseBtn

    local MinimizeBtn = Instance.new("TextButton")
    MinimizeBtn.Name = "MinimizeBtn"
    MinimizeBtn.Text = "−"
    MinimizeBtn.Font = Enum.Font.GothamBold
    MinimizeBtn.TextSize = 14
    MinimizeBtn.TextColor3 = TEXT_COLOR
    MinimizeBtn.BackgroundColor3 = RED_ACCENT
    MinimizeBtn.Position = UDim2.new(1, -68, 0, 10)
    MinimizeBtn.Size = UDim2.new(0, 26, 0, 26)
    MinimizeBtn.Parent = MainBG

    local MinimizeBtnCorner = Instance.new("UICorner")
    MinimizeBtnCorner.CornerRadius = UDim.new(0, 6)
    MinimizeBtnCorner.Parent = MinimizeBtn

    local HeaderBtn = Instance.new("TextButton")
    HeaderBtn.Name = "HeaderBtn"
    HeaderBtn.Text = winName
    HeaderBtn.Font = Enum.Font.GothamBold
    HeaderBtn.TextSize = 14
    HeaderBtn.TextColor3 = TEXT_COLOR
    HeaderBtn.BackgroundColor3 = RED_ACCENT
    HeaderBtn.Position = UDim2.new(0.5, -100, 1, -36)
    HeaderBtn.Size = UDim2.new(0, 200, 0, 30)
    HeaderBtn.Visible = false
    HeaderBtn.Parent = MainGUI

    local HeaderBtnCorner = Instance.new("UICorner")
    HeaderBtnCorner.CornerRadius = UDim.new(0, 8)
    HeaderBtnCorner.Parent = HeaderBtn

    -- Primary Event Map Connectors
    CloseBtn.MouseButton1Click:Connect(function()
        cleanupConnections()
        MainGUI:Destroy()
    end)

    MinimizeBtn.MouseButton1Click:Connect(function()
        MainBG.Visible = false
        HeaderBtn.Visible = true
    end)

    HeaderBtn.MouseButton1Click:Connect(function()
        HeaderBtn.Visible = false
        MainBG.Visible = true
    end)

    dragify(MainBG)
    setupResize(MainBG)

    local Tabs = {}
    local LoadedSections = {}

    function Tabs:AddSection(SectionName)
        local Tab1 = Instance.new("ImageButton")
        Tab1.Name = SectionName
        Tab1.Size = UDim2.new(0, 95, 0, 24)
        Tab1.BackgroundColor3 = BG_MEDIUM
        Tab1.BorderSizePixel = 0
        Tab1.AutoButtonColor = false
        Tab1.Parent = TabsContainer

        local UICorner = Instance.new("UICorner")
        UICorner.CornerRadius = UDim.new(0, 6)
        UICorner.Parent = Tab1

        local TabStroke = Instance.new("UIStroke")
        TabStroke.Color = RED_ACCENT
        TabStroke.Thickness = 1
        TabStroke.Parent = Tab1

        local TabName = Instance.new("TextLabel")
        TabName.Name = "TabName"
        TabName.Text = SectionName
        TabName.Font = Enum.Font.GothamBold
        TabName.TextSize = 12
        TabName.TextColor3 = TEXT_COLOR
        TabName.Size = UDim2.new(1, 0, 1, 0)
        TabName.BackgroundTransparency = 1
        TabName.Parent = Tab1

        local Filler = Instance.new("Frame")
        Filler.Name = "Filler"
        Filler.AnchorPoint = Vector2.new(0.5, 1)
        Filler.Position = UDim2.new(0.5, 0, 1, 0)
        Filler.Size = UDim2.new(1, 0, 0, 2)
        Filler.BackgroundColor3 = RED_ACCENT
        Filler.BorderSizePixel = 0
        Filler.Visible = false
        Filler.Parent = Tab1

        local Section = Instance.new("ScrollingFrame")
        Section.Name = SectionName
        Section.BackgroundTransparency = 1
        Section.BorderSizePixel = 0
        Section.Position = UDim2.new(0, 8, 0, 44)
        Section.Size = UDim2.new(1, -16, 1, -52)
        Section.ScrollBarThickness = 4
        Section.ScrollBarImageColor3 = RED_ACCENT
        Section.AutomaticCanvasSize = Enum.AutomaticSize.Y
        Section.CanvasSize = UDim2.new(0, 0, 0, 0)
        Section.Visible = false
        Section.Parent = SectionContainer

        local UIListLayout = Instance.new("UIListLayout")
        UIListLayout.Padding = UDim.new(0, 6)
        UIListLayout.SortOrder = Enum.SortOrder.LayoutOrder
        UIListLayout.Parent = Section

        local SectionPadding = Instance.new("UIPadding")
        SectionPadding.PaddingLeft = UDim.new(0, 4)
        SectionPadding.PaddingRight = UDim.new(0, 4)
        SectionPadding.PaddingTop = UDim.new(0, 4)
        SectionPadding.PaddingBottom = UDim.new(0, 4)
        SectionPadding.Parent = Section

        table.insert(LoadedSections, Section)

        Tab1.MouseButton1Click:Connect(function()
            for _, v in ipairs(LoadedSections) do
                v.Visible = false
                local tBtn = TabsContainer:FindFirstChild(v.Name)
                if tBtn then
                    tBtn.BackgroundColor3 = BG_MEDIUM
                    tBtn.Filler.Visible = false
                end
            end
            Section.Visible = true
            Tab1.BackgroundColor3 = BG_DARK
            Filler.Visible = true
        end)

        local Contents = {}

        -- Universal Element Tweener Helper
        local function bindHoverStates(instance, stroke)
            trackConnection(instance.MouseEnter:Connect(function()
                fastTween(instance, TweenInfo.new(0.2), {BackgroundColor3 = Color3.fromRGB(50, 50, 68)})
                if stroke then fastTween(stroke, TweenInfo.new(0.2), {Color = RED_LIGHT}) end
            end))
            trackConnection(instance.MouseLeave:Connect(function()
                fastTween(instance, TweenInfo.new(0.2), {BackgroundColor3 = BG_MEDIUM})
                if stroke then fastTween(stroke, TweenInfo.new(0.2), {Color = RED_ACCENT}) end
            end))
        end

        function Contents:Button(lbltxt, cb)
            local BtnInstance = Instance.new("ImageButton")
            BtnInstance.Name = "BtnInstance"
            BtnInstance.Size = UDim2.new(1, 0, 0, 38)
            BtnInstance.BackgroundColor3 = BG_MEDIUM
            BtnInstance.BorderSizePixel = 0
            BtnInstance.AutoButtonColor = false
            BtnInstance.Parent = Section

            local BtnCorner = Instance.new("UICorner")
            BtnCorner.CornerRadius = UDim.new(0, 8)
            BtnCorner.Parent = BtnInstance

            local BtnName = Instance.new("TextLabel")
            BtnName.Name = "BtnName"
            BtnName.Text = lbltxt
            BtnName.Font = Enum.Font.GothamMedium
            BtnName.TextSize = 13
            BtnName.TextColor3 = TEXT_COLOR
            BtnName.TextXAlignment = Enum.TextXAlignment.Left
            BtnName.Position = UDim2.new(0, 36, 0, 0)
            BtnName.Size = UDim2.new(1, -42, 1, 0)
            BtnName.BackgroundTransparency = 1
            BtnName.Parent = BtnInstance

            local BtnStroke = Instance.new("UIStroke")
            BtnStroke.Color = RED_ACCENT
            BtnStroke.Thickness = 1
            BtnStroke.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
            BtnStroke.Parent = BtnInstance

            local BtnIco = Instance.new("ImageLabel")
            BtnIco.Name = "BtnIco"
            BtnIco.Size = UDim2.new(0, 18, 0, 18)
            BtnIco.Position = UDim2.new(0, 10, 0.5, -9)
            BtnIco.Image = "rbxassetid://16884178577"
            BtnIco.ImageRectOffset = Vector2.new(0, 152)
            BtnIco.ImageRectSize = Vector2.new(36, 36)
            BtnIco.ImageColor3 = RED_ACCENT
            BtnIco.BackgroundTransparency = 1
            BtnIco.Parent = BtnInstance

            bindHoverStates(BtnInstance, BtnStroke)
            trackConnection(BtnInstance.MouseButton1Click:Connect(function()
                pcall(cb)
            end))
        end

        function Contents:Label(lbltxt)
            local LabelInstance = Instance.new("Frame")
            LabelInstance.Name = "LabelInstance"
            LabelInstance.Size = UDim2.new(1, 0, 0, 34)
            LabelInstance.BackgroundColor3 = BG_MEDIUM
            LabelInstance.BorderSizePixel = 0
            LabelInstance.Parent = Section

            local LabelCorner = Instance.new("UICorner")
            LabelCorner.CornerRadius = UDim.new(0, 8)
            LabelCorner.Parent = LabelInstance

            local LabelName = Instance.new("TextLabel")
            LabelName.Name = "LabelName"
            LabelName.Text = lbltxt
            LabelName.Font = Enum.Font.GothamMedium
            LabelName.TextSize = 13
            LabelName.TextColor3 = TEXT_COLOR
            LabelName.TextXAlignment = Enum.TextXAlignment.Left
            LabelName.Position = UDim2.new(0, 36, 0, 0)
            LabelName.Size = UDim2.new(1, -42, 1, 0)
            LabelName.BackgroundTransparency = 1
            LabelName.Parent = LabelInstance

            local LabelStroke = Instance.new("UIStroke")
            LabelStroke.Color = RED_DARK
            LabelStroke.Thickness = 1
            LabelStroke.Parent = LabelInstance

            local LabelIco = Instance.new("ImageLabel")
            LabelIco.Name = "LabelIco"
            LabelIco.Size = UDim2.new(0, 18, 0, 18)
            LabelIco.Position = UDim2.new(0, 10, 0.5, -9)
            LabelIco.Image = "rbxassetid://16884178261"
            LabelIco.ImageRectOffset = Vector2.new(418, 0)
            LabelIco.ImageRectSize = Vector2.new(36, 36)
            LabelIco.ImageColor3 = RED_ACCENT
            LabelIco.BackgroundTransparency = 1
            LabelIco.Parent = LabelInstance

            local upd = {}
            function upd:Update(newtxt)
                LabelName.Text = newtxt
            end
            return upd
        end

        function Contents:Toggle(lbltxt, val, cb)
            local ToggleInstance = Instance.new("ImageButton")
            ToggleInstance.Name = "ToggleInstance"
            ToggleInstance.Size = UDim2.new(1, 0, 0, 38)
            ToggleInstance.BackgroundColor3 = BG_MEDIUM
            ToggleInstance.BorderSizePixel = 0
            ToggleInstance.AutoButtonColor = false
            ToggleInstance.Parent = Section

            local ToggleCorner = Instance.new("UICorner")
            ToggleCorner.CornerRadius = UDim.new(0, 8)
            ToggleCorner.Parent = ToggleInstance

            local ToggleName = Instance.new("TextLabel")
            ToggleName.Name = "ToggleName"
            ToggleName.Text = lbltxt
            ToggleName.Font = Enum.Font.GothamMedium
            ToggleName.TextSize = 13
            ToggleName.TextColor3 = TEXT_COLOR
            ToggleName.TextXAlignment = Enum.TextXAlignment.Left
            ToggleName.Position = UDim2.new(0, 36, 0, 0)
            ToggleName.Size = UDim2.new(1, -42, 1, 0)
            ToggleName.BackgroundTransparency = 1
            ToggleName.Parent = ToggleInstance

            local ToggleStroke = Instance.new("UIStroke")
            ToggleStroke.Color = RED_ACCENT
            ToggleStroke.Thickness = 1
            ToggleStroke.Parent = ToggleInstance

            local Icon = Instance.new("ImageLabel")
            Icon.Name = "ToggleIcon"
            Icon.Size = UDim2.new(0, 18, 0, 18)
            Icon.Position = UDim2.new(0, 10, 0.5, -9)
            Icon.Image = "rbxassetid://16167590639"
            Icon.BackgroundTransparency = 1
            Icon.Parent = ToggleInstance

            local toggled = val
            local function updateToggleVisuals()
                if toggled then
                    Icon.ImageRectOffset = Vector2.new(286, 386)
                    Icon.ImageColor3 = RED_LIGHT
                else
                    Icon.ImageRectOffset = Vector2.new(248, 462)
                    Icon.ImageColor3 = RED_ACCENT
                end
                Icon.ImageRectSize = Vector2.new(36, 36)
            end
            updateToggleVisuals()

            bindHoverStates(ToggleInstance, ToggleStroke)
            
            trackConnection(ToggleInstance.MouseButton1Click:Connect(function()
                toggled = not toggled
                updateToggleVisuals()
                pcall(cb, toggled)
            end))
        end

        function Contents:TextBox(lbltxt, cb)
            local TextBoxInstance = Instance.new("Frame")
            TextBoxInstance.Name = "TextBoxInstance"
            TextBoxInstance.Size = UDim2.new(1, 0, 0, 48)
            TextBoxInstance.BackgroundColor3 = BG_MEDIUM
            TextBoxInstance.BorderSizePixel = 0
            TextBoxInstance.Parent = Section

            local TextBoxCorner = Instance.new("UICorner")
            TextBoxCorner.CornerRadius = UDim.new(0, 8)
            TextBoxCorner.Parent = TextBoxInstance

            local TextBoxName = Instance.new("TextLabel")
            TextBoxName.Name = "TextBoxName"
            TextBoxName.Text = lbltxt
            TextBoxName.Font = Enum.Font.GothamBold
            TextBoxName.TextSize = 11
            TextBoxName.TextColor3 = RED_LIGHT
            TextBoxName.TextXAlignment = Enum.TextXAlignment.Left
            TextBoxName.Position = UDim2.new(0, 12, 0, 4)
            TextBoxName.Size = UDim2.new(1, -24, 0, 16)
            TextBoxName.BackgroundTransparency = 1
            TextBoxName.Parent = TextBoxInstance

            local TextBoxFrame = Instance.new("Frame")
            TextBoxFrame.Name = "TextBoxFrame"
            TextBoxFrame.BackgroundColor3 = BG_DARK
            TextBoxFrame.Position = UDim2.new(0, 12, 0, 22)
            TextBoxFrame.Size = UDim2.new(1, -24, 0, 20)
            TextBoxFrame.Parent = TextBoxInstance

            local TBFCORNER = Instance.new("UICorner")
            TBFCORNER.CornerRadius = UDim.new(0, 4)
            TBFCORNER.Parent = TextBoxFrame

            local TBFSTROKE = Instance.new("UIStroke")
            TBFSTROKE.Color = RED_ACCENT
            TBFSTROKE.Thickness = 1
            TBFSTROKE.Parent = TextBoxFrame

            local TextBoxInput = Instance.new("TextBox")
            TextBoxInput.Name = "TextBoxInput"
            TextBoxInput.Text = ""
            TextBoxInput.PlaceholderText = "Type here..."
            TextBoxInput.PlaceholderColor3 = Color3.fromRGB(120, 120, 120)
            TextBoxInput.TextColor3 = TEXT_COLOR
            TextBoxInput.Font = Enum.Font.Gotham
            TextBoxInput.TextSize = 12
            TextBoxInput.TextXAlignment = Enum.TextXAlignment.Left
            TextBoxInput.Size = UDim2.new(1, -10, 1, 0)
            TextBoxInput.Position = UDim2.new(0, 5, 0, 0)
            TextBoxInput.BackgroundTransparency = 1
            TextBoxInput.ClipsDescendants = true
            TextBoxInput.Parent = TextBoxFrame

            trackConnection(TextBoxInput.Focused:Connect(function()
                fastTween(TBFSTROKE, TweenInfo.new(0.2), {Color = RED_LIGHT})
            end))

            trackConnection(TextBoxInput.FocusLost:Connect(function(enterPressed)
                fastTween(TBFSTROKE, TweenInfo.new(0.2), {Color = RED_ACCENT})
                pcall(cb, TextBoxInput.Text, enterPressed)
            end))
        end

        return Contents
    end

    return Tabs
end

return SimpleLib
