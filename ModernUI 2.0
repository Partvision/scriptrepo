        table.insert(LoadedSections, Section)

        Tab1.MouseButton1Click:Connect(function()
            for i, v in pairs(LoadedSections) do
                v.Visible = false
                if TabsContainer:FindFirstChild(v.Name) then
                    TabsContainer[v.Name].BackgroundColor3 = BG_MEDIUM
                    TabsContainer[v.Name].Filler.Visible = false
                end
            end

            Section.Visible = true
            Tab1.BackgroundColor3 = BG_DARK
            Filler.Visible = true
        end)

        Tab1.MouseEnter:Connect(function()
            if Section.Visible == false then
                Tab1.BackgroundColor3 = Color3.fromRGB(50, 50, 70)
            end
        end)

        Tab1.MouseLeave:Connect(function()
            if Section.Visible == false then
                Tab1.BackgroundColor3 = BG_MEDIUM
            end
        end)

